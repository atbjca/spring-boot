			<url>${boot.repository.url}</url>
		</repository>
		<repository>
			<id>nes-public</id>
			<url>http://192.168.131.36:8088/repository/maven-public/</url>
		</repository>
		<repository>
			<id>nes-snapshots</id>
			<url>http://192.168.131.36:8088/repository/snapshots/</url>
